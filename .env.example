# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# (Optional) Self-hosted Telegram Bot API server for >20MB downloads via Bot API
# e.g., http://localhost:8081
TELEGRAM_API_SERVER=

# (Optional) Telethon MTProto Client for downloading files up to 2GB directly
# Obtain api_id and api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=ulp_cleaner_userbot

# Storage directories
DATA_DIR=data
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE_LINES=500000
